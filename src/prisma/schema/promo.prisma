model Promo {
  id        Int      @id @default(autoincrement())
  title     String
  text      String
  link      String
  startDate DateTime
  endDate   DateTime
  image     Image    @relation(fields: [imageId], references: [id])
  imageId   Int      @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
